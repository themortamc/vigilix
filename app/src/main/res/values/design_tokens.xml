    <!-- Surface variants -->
    <color name="vx_color_surface">#FFFFFF</color>
    <color name="vx_color_surface_variant">#F6F6F6</color>
    <color name="vx_color_surface_container">#EDEDED</color>
    <color name="vx_color_surface_container_high">#E0E0E0</color>

    <!-- Icon colors -->
    <color name="vx_color_icon_primary">#1E1E1E</color>
    <color name="vx_color_icon_secondary">#5C5C5C</color>
    <color name="vx_color_icon_accent">#8B6CEF</color>

    <!-- Scrim -->
    <color name="vx_color_scrim">#000000</color>

    <!-- Shadow colors (for custom shadows) -->
    <color name="vx_shadow_color_umbra">#1F000000</color>
    <color name="vx_shadow_color_penumbra">#14000000</color>
    <color name="vx_shadow_color_ambient">#0F000000</color>

    <!-- ===== SPACING TOKENS (4dp base unit) ===== -->
    <dimen name="vx_space_0">0dp</dimen>
    <dimen name="vx_space_1">4dp</dimen>
    <dimen name="vx_space_2">8dp</dimen>
    <dimen name="vx_space_3">12dp</dimen>
    <dimen name="vx_space_4">16dp</dimen>
    <dimen name="vx_space_5">20dp</dimen>
    <dimen name="vx_space_6">24dp</dimen>
    <dimen name="vx_space_7">28dp</dimen>
    <dimen name="vx_space_8">32dp</dimen>
    <dimen name="vx_space_10">40dp</dimen>
    <dimen name="vx_space_12">48dp</dimen>
    <dimen name="vx_space_16">64dp</dimen>
    <dimen name="vx_space_20">80dp</dimen>
    <dimen name="vx_space_24">96dp</dimen>

    <!-- Component-specific spacing -->
    <dimen name="vx_inset_small">8dp</dimen>
    <dimen name="vx_inset_medium">16dp</dimen>
    <dimen name="vx_inset_large">24dp</dimen>
    <dimen name="vx_gap_small">4dp</dimen>
    <dimen name="vx_gap_medium">8dp</dimen>
    <dimen name="vx_gap_large">16dp</dimen>
    <dimen name="vx_gap_xlarge">24dp</dimen>

    <!-- Touch targets (min 48dp per WCAG) -->
    <dimen name="vx_touch_target_min">48dp</dimen>
    <dimen name="vx_touch_target_comfortable">56dp</dimen>

    <!-- ===== TYPOGRAPHY TOKENS ===== -->
    <!-- Font families (as strings) -->
    <string name="vx_font_family_sans">sans-serif</string>
    <string name="vx_font_family_sans_medium">sans-serif-medium</string>
    <string name="vx_font_family_sans_bold">sans-serif-black</string>
    <string name="vx_font_family_mono">monospace</string>

    <!-- Font sizes (sp) -->
    <dimen name="vx_text_size_display_large">57sp</dimen>
    <dimen name="vx_text_size_display_medium">45sp</dimen>
    <dimen name="vx_text_size_display_small">36sp</dimen>

    <dimen name="vx_text_size_headline_large">32sp</dimen>
    <dimen name="vx_text_size_headline_medium">28sp</dimen>
    <dimen name="vx_text_size_headline_small">24sp</dimen>

    <dimen name="vx_text_size_title_large">22sp</dimen>
    <dimen name="vx_text_size_title_medium">18sp</dimen>
    <dimen name="vx_text_size_title_small">16sp</dimen>

    <dimen name="vx_text_size_label_large">14sp</dimen>
    <dimen name="vx_text_size_label_medium">12sp</dimen>
    <dimen name="vx_text_size_label_small">11sp</dimen>

    <dimen name="vx_text_size_body_large">16sp</dimen>
    <dimen name="vx_text_size_body_medium">14sp</dimen>
    <dimen name="vx_text_size_body_small">12sp</dimen>

    <!-- Line heights (as integers - multiply by 100 in code: 120 = 1.2) -->
    <integer name="vx_line_height_tight">120</integer>
    <integer name="vx_line_height_normal">150</integer>
    <integer name="vx_line_height_relaxed">175</integer>

    <!-- Letter spacing (as integers - multiply by 1000 in code: 20 = 0.02) -->
    <integer name="vx_letter_spacing_tight">20</integer>
    <integer name="vx_letter_spacing_normal">0</integer>
    <integer name="vx_letter_spacing_wide">40</integer>

    <!-- Font weights -->
    <integer name="vx_font_weight_light">300</integer>
    <integer name="vx_font_weight_normal">400</integer>
    <integer name="vx_font_weight_medium">500</integer>
    <integer name="vx_font_weight_semibold">600</integer>
    <integer name="vx_font_weight_bold">700</integer>

    <!-- ===== MOTION TOKENS ===== -->
    <!-- Duration (ms) -->
    <integer name="vx_motion_duration_instant">0</integer>
    <integer name="vx_motion_duration_fast">100</integer>
    <integer name="vx_motion_duration_medium">200</integer>
    <integer name="vx_motion_duration_slow">300</integer>
    <integer name="vx_motion_duration_xslow">500</integer>

    <!-- Easing curves (as strings for interpolation) -->
    <string name="vx_easing_standard">0.2, 0.0, 0, 1</string>       <!-- Material standard -->
    <string name="vx_easing_emphasized">0.2, 0.0, 0, 1</string>    <!-- Emphasized deceleration -->
    <string name="vx_easing_accelerate">0.4, 0.0, 1, 1</string>    <!-- Acceleration -->
    <string name="vx_easing_decelerate">0.0, 0.0, 0.2, 1</string>  <!-- Deceleration -->
    <string name="vx_easing_linear">0.0, 0.0, 1.0, 1.0</string>    <!-- Linear -->
    <string name="vx_easing_spring">0.34, 1.56, 0.64, 1</string>   <!-- Spring overshoot -->

    <!-- Spring physics (as integers - divide by 100 in code: 15000 = 150) -->
    <integer name="vx_spring_stiffness_low">15000</integer>      <!-- Gentle -->
    <integer name="vx_spring_stiffness_medium">40000</integer>   <!-- Standard -->
    <integer name="vx_spring_stiffness_high">80000</integer>     <!-- Snappy -->
    <!-- Damping ratios (as fractions 0-1000: 750 = 0.75) -->
    <integer name="vx_spring_damping_ratio_low">750</integer>    <!-- Bouncy -->
    <integer name="vx_spring_damping_ratio_medium">900</integer>  <!-- Slight bounce -->
    <integer name="vx_spring_damping_ratio_high">1000</integer>    <!-- Critical damping -->

    <!-- Stagger delay -->
    <integer name="vx_motion_stagger_delay">50</integer>

    <!-- ===== SHAPE / RADIUS TOKENS ===== -->
    <dimen name="vx_radius_none">0dp</dimen>
    <dimen name="vx_radius_xs">4dp</dimen>
    <dimen name="vx_radius_small">8dp</dimen>
    <dimen name="vx_radius_medium">12dp</dimen>
    <dimen name="vx_radius_large">16dp</dimen>
    <dimen name="vx_radius_xlarge">24dp</dimen>
    <dimen name="vx_radius_full">9999dp</dimen> <!-- Pills, circles -->

    <!-- Component-specific radii -->
    <dimen name="vx_radius_button">8dp</dimen>
    <dimen name="vx_radius_card">12dp</dimen>
    <dimen name="vx_radius_chip">16dp</dimen>
    <dimen name="vx_radius_dialog">16dp</dimen>
    <dimen name="vx_radius_bottom_sheet">16dp</dimen>
    <dimen name="vx_radius_fab">16dp</dimen>

    <!-- ===== ELEVATION / SHADOW TOKENS ===== -->
    <dimen name="vx_elevation_level_0">0dp</dimen>
    <dimen name="vx_elevation_level_1">1dp</dimen>
    <dimen name="vx_elevation_level_2">3dp</dimen>
    <dimen name="vx_elevation_level_3">6dp</dimen>
    <dimen name="vx_elevation_level_4">8dp</dimen>
    <dimen name="vx_elevation_level_5">12dp</dimen>

    <!-- ===== Z-INDEX TOKENS ===== -->
    <integer name="vx_z_index_base">0</integer>
    <integer name="vx_z_index_raised">1</integer>
    <integer name="vx_z_index_dropdown">100</integer>
    <integer name="vx_z_index_sticky">200</integer>
    <integer name="vx_z_index_modal_backdrop">1000</integer>
    <integer name="vx_z_index_modal">1010</integer>
    <integer name="vx_z_index_popover">1100</integer>
    <integer name="vx_z_index_tooltip">1200</integer>
    <integer name="vx_z_index_toast">1300</integer>

    <!-- ===== BREAKPOINTS (for responsive layouts) ===== -->
    <dimen name="vx_breakpoint_compact">0dp</dimen>       <!-- < 600dp -->
    <dimen name="vx_breakpoint_medium">600dp</dimen>      <!-- 600-840dp -->
    <dimen name="vx_breakpoint_expanded">840dp</dimen>    <!-- 840-1200dp -->
    <dimen name="vx_breakpoint_large">1200dp</dimen>      <!-- 1200-1600dp -->
    <dimen name="vx_breakpoint_xlarge">1600dp</dimen>     <!-- > 1600dp -->

    <!-- ===== ICON SIZES ===== -->
    <dimen name="vx_icon_size_xs">16dp</dimen>
    <dimen name="vx_icon_size_small">20dp</dimen>
    <dimen name="vx_icon_size_medium">24dp</dimen>
    <dimen name="vx_icon_size_large">32dp</dimen>
    <dimen name="vx_icon_size_xlarge">48dp</dimen>

    <!-- ===== TRANSITION PATTERNS ===== -->
    <!-- Standard container transform -->
    <integer name="vx_transition_container_duration">300</integer>
    <string name="vx_transition_container_easing">@string/vx_easing_standard</string>

    <!-- Fade -->
    <integer name="vx_transition_fade_duration">150</integer>
    <string name="vx_transition_fade_easing">@string/vx_easing_decelerate</string>

    <!-- Slide -->
    <integer name="vx_transition_slide_duration">250</integer>
    <string name="vx_transition_slide_easing">@string/vx_easing_standard</string>

    <!-- Scale -->
    <integer name="vx_transition_scale_duration">200</integer>
    <string name="vx_transition_scale_easing">@string/vx_easing_spring</string>
</resources>