    <!-- Brand / Accent -->
    <color name="vx_color_accent_primary">#7A5AE0</color>
    <color name="vx_color_accent_secondary">#5B3FC4</color>
    <color name="vx_color_accent_tertiary">#EEEAFB</color>
    <color name="vx_color_accent_container">#EEEAFB</color>
    <color name="vx_color_accent_on_container">#3A2A7A</color>

    <!-- Semantic State Colors -->
    <color name="vx_color_success">#17702F</color>
    <color name="vx_color_success_container">#E3F4E8</color>
    <color name="vx_color_success_on_container">#0D421A</color>

    <color name="vx_color_warning">#9A5700</color>
    <color name="vx_color_warning_container">#FFF0D9</color>
    <color name="vx_color_warning_on_container">#5C3500</color>

    <color name="vx_color_error">#C6282B</color>
    <color name="vx_color_error_container">#FDE7E7</color>
    <color name="vx_color_error_on_container">#701618</color>

    <color name="vx_color_info">#0A6C7E</color>
