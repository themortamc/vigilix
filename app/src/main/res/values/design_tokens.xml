<?xml version="1.0" encoding="utf-8"?>
<!-- Design Tokens - Vigilix Design System -->
<!-- Source of truth for colors, spacing, typography, motion, elevation, radius -->
<!-- Only valid Android resource types used: string, integer, dimen, color, bool, fraction -->
<resources>
    <!-- ===== COLOR TOKENS ===== -->
    <!-- Semantic colors (light theme) -->
    <color name="vx_color_bg_primary">#FFFFFF</color>
    <color name="vx_color_bg_secondary">#F6F6F6</color>
    <color name="vx_color_bg_tertiary">#EDEDED</color>
    <color name="vx_color_bg_inverse">#1E1E1E</color>
    <color name="vx_color_bg_overlay">#80000000</color> <!-- 50% black -->

    <color name="vx_color_text_primary">#222222</color>
    <color name="vx_color_text_secondary">#5C5C5C</color>
    <color name="vx_color_text_tertiary">#999999</color>
    <color name="vx_color_text_inverse">#FFFFFF</color>
    <color name="vx_color_text_on_accent">#FFFFFF</color>
    <color name="vx_color_text_link">#7A5AE0</color>

    <color name="vx_color_border_light">#DADADA</color>
    <color name="vx_color_border_medium">#CCCCCC</color>
    <color name="vx_color_border_focus">#7A5AE0</color>
