<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="VxHeading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/vx_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="VxTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/vx_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="VxButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/vx_btn_text</item>
        <item name="android:backgroundTint">@color/vx_btn_bg</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="VxButtonSecondary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/vx_btn_text</item>
        <item name="android:backgroundTint">@color/vx_btn_bg_secondary</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
