    <!-- Bóveda -->
    <string name="vault_title">Contraseñas</string>
    <string name="vault_subtitle">Guardá tus usuarios y claves, y usalas rápido con un toque o con el autocompletado.</string>
    <string name="vault_info_title">Cómo se protegen</string>
    <string name="vault_info_body">Todo se cifra en tu teléfono con tu clave maestra (Argon2id + ChaCha20-Poly1305) y no sale de él. Si perdés la clave maestra no hay forma de recuperar las contraseñas: nadie, tampoco yo, puede restablecerla.</string>
