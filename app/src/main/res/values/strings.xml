    <!-- Escáner -->
    <string name="scan_title">Escáner</string>
    <string name="scan_subtitle">Buscá archivos y apps que coincidan con malware conocido.</string>
    <string name="scan_info_title">Qué hace y qué no hace</string>
    <string name="scan_info_body">Calcula la huella (SHA-256) de tus archivos y apps y la compara con una lista de malware conocido, y opcionalmente con VirusTotal. Solo detecta archivos idénticos a muestras ya conocidas: no analiza el comportamiento ni detecta variantes nuevas. Que no aparezca algo no significa que sea seguro. Los archivos nunca salen del teléfono: solo se consulta su huella.</string>
    <string name="scan_phone_heading">Escanear el teléfono</string>
    <string name="scan_mode_quick">Rápido</string>
    <string name="scan_mode_full">Completo</string>
    <string name="scan_mode_quick_hint">Rápido: instaladores, ejecutables, scripts, comprimidos, PDF y documentos de Office, más las apps instaladas.</string>
    <string name="scan_mode_full_hint">Completo: todos los archivos del almacenamiento (hasta 2 GB cada uno), más las apps instaladas. Puede tardar bastante.</string>
    <string name="scan_use_vt">Consultar también VirusTotal</string>
    <string name="scan_vt_hint_ready">Solo para apps y archivos ejecutables que no estén en la lista. El plan gratis permite 4 consultas por minuto, así que se hacen a ritmo lento y hasta 40 por escaneo.</string>
    <string name="scan_vt_hint_nokey">Necesita tu propia API key gratuita de VirusTotal (se configura más abajo).</string>
    <string name="scan_start">Escanear ahora</string>
    <string name="scan_cancel">Cancelar</string>
    <string name="scan_grant_access">Dar acceso a todos los archivos</string>
    <string name="scan_perm_title">Falta el permiso de archivos</string>
    <string name="scan_perm_body">Para recorrer el almacenamiento, Android exige un permiso especial. Solo se usa para leer archivos y calcular su huella; Vigilix no modifica nada por su cuenta.</string>
    <string name="scan_status_files">Analizados: %1$d archivos (%2$s)</string>
