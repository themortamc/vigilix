<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- Barra Superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="#161B22"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ VIGILIX PRO"
            android:textColor="#58A6FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrivilegeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODO: DETECTANDO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#21262D"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomNav"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= TAB 1: DASHBOARD & DNS ================= -->
            <LinearLayout
                android:id="@+id/tabDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Estado del sistema -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B22"
                    app:strokeColor="#30363D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTADO DEL SISTEMA"
                            android:textColor="#8B949E"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHealthScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100% Protegido"
                            android:textColor="#3FB950"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvHealthSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Motor Rust activo • Hilos de escaneo en segundo plano."
                            android:textColor="#C9D1D9"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- CONTROLADOR DE DNS ADGUARD / PRIVADO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B22"
                    app:strokeColor="#30363D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌐 DNS ENCRIPTADO (SIN VPN)"
                            android:textColor="#58A6FF"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aplica filtrado de publicidad y phishing en todo el celular."
                            android:textColor="#8B949E"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <RadioGroup
                            android:id="@+id/rgDns"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">
                            <RadioButton
                                android:id="@+id/rbAdGuard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AdGuard DNS (Bloquea Anuncios + Rastreadores)"
                                android:textColor="#C9D1D9"
                                android:checked="true" />
                            <RadioButton
                                android:id="@+id/rbQuad9"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quad9 DNS (Especializado contra Malware)"
                                android:textColor="#C9D1D9" />
                            <RadioButton
                                android:id="@+id/rbDnsOff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DNS Automático / Desactivado"
                                android:textColor="#C9D1D9" />
                        </RadioGroup>

                        <Button
                            android:id="@+id/btnApplyDns"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Aplicar DNS con Root / ADB"
                            android:backgroundTint="#238636"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvDnsStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#8B949E"
                            android:textSize="12sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= TAB 2: ESCÁNER VIRUSTOTAL ================= -->
            <LinearLayout
                android:id="@+id/tabScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B22"
                    app:strokeColor="#30363D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESCÁNER DE ARCHIVOS ASÍNCRONO"
                            android:textColor="#58A6FF"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/btnScanStorage"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="Escanear Descargas (Coroutines + Rust)"
                            android:backgroundTint="#1F6FEB"
                            android:layout_marginTop="12dp" />

                        <ProgressBar
                            android:id="@+id/pbScanner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:indeterminate="true"
                            android:visibility="gone"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/tvScanLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Presiona para analizar firmas de archivos."
                            android:textColor="#C9D1D9"
                            android:textSize="12sp"
                            android:padding="12dp"
                            android:background="#0D1117"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= TAB 3: BÓVEDA Y CONTRASEÑAS ================= -->
            <LinearLayout
                android:id="@+id/tabVault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B22"
                    app:strokeColor="#30363D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONFIGURADOR DE CONTRASEÑA"
                            android:textColor="#3FB950"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvLengthLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Longitud: 32 caracteres (Alta Entropía)"
                            android:textColor="#C9D1D9"
                            android:textSize="13sp"
                            android:layout_marginTop="8dp" />

                        <!-- Selector de largo -->
                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderLength"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="12"
                            android:valueTo="64"
                            android:stepSize="4"
                            android:value="32" />

                        <Button
                            android:id="@+id/btnGenerateSecret"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Generar con Rust CSPRNG"
                            android:backgroundTint="#238636" />

                        <TextView
                            android:id="@+id/tvEntropyPass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Toca generar..."
                            android:textColor="#7EE787"
                            android:textSize="14sp"
                            android:padding="12dp"
                            android:background="#0D1117"
                            android:layout_marginTop="8dp" />

                        <Button
                            android:id="@+id/btnCopyPass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Copiar al Portapapeles"
                            android:backgroundTint="#21262D"
                            android:textColor="#58A6FF"
                            android:layout_marginTop="6dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#30363D"
                            android:layout_marginVertical="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GESTOR DE SECRETOS (ARGON2ID + CHACHA20)"
                            android:textColor="#D29922"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etVaultKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Llave Maestra"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#6E7681"
                            android:inputType="textPassword"
                            android:layout_marginTop="8dp" />

                        <EditText
                            android:id="@+id/etVaultData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Dato secreto (ej: Token API, Clave privada)"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#6E7681" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <Button
                                android:id="@+id/btnEncryptVault"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cifrar"
                                android:backgroundTint="#8957E5"
                                android:layout_marginEnd="4dp" />

                            <Button
                                android:id="@+id/btnDecryptVault"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Descifrar"
                                android:backgroundTint="#30363D"
                                android:textColor="#FFFFFF"
                                android:layout_marginStart="4dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvVaultOutput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#C9D1D9"
                            android:textSize="11sp"
                            android:padding="8dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= TAB 4: SANDBOX BREVENT & GUÍA ADB ================= -->
            <LinearLayout
                android:id="@+id/tabSandbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B22"
                    app:strokeColor="#30363D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VINCULACIÓN PRIVILEGIADA (BREVENT / ADB)"
                            android:textColor="#F85149"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sin Root, puedes habilitar privilegios conectando por Depuración USB/Inalámbrica."
                            android:textColor="#8B949E"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                        <Button
                            android:id="@+id/btnOpenDevSettings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Abrir Opciones de Desarrollador"
                            android:backgroundTint="#30363D"
                            android:textColor="#58A6FF"
                            android:layout_marginTop="10dp" />

                        <Button
                            android:id="@+id/btnCopyAdbCmd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Copiar Comando ADB para PC"
                            android:backgroundTint="#21262D"
                            android:textColor="#C9D1D9"
                            android:layout_marginTop="6dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#30363D"
                            android:layout_marginVertical="12dp" />

                        <Button
                            android:id="@+id/btnAuditPermissions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Escanear Apps Críticas"
                            android:backgroundTint="#DA3633" />

                        <Button
                            android:id="@+id/btnBreventFreeze"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Congelar App en Segundo Plano"
                            android:backgroundTint="#1F6FEB"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvSandboxLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Estado: Esperando acción."
                            android:textColor="#FFA198"
                            android:textSize="12sp"
                            android:padding="12dp"
                            android:background="#0D1117"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Barra Inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#161B22"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
