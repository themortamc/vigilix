<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:background="#161B22"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ VIGILIX PRO"
            android:textColor="#58A6FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrivilegeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODO: DETECTANDO"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#21262D"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />
    </LinearLayout>

    <!-- Contenedor Scrollable para los Módulos -->
    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomNav"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= TAB 1: DASHBOARD ================= -->
            <LinearLayout
                android:id="@+id/tabDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Tarjeta Score de Salud -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B22"
                    app:strokeColor="#30363D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTADO DE PRIVACIDAD GLOBAL"
                            android:textColor="#8B949E"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHealthScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="98.5%"
                            android:textColor="#3FB950"
                            android:textSize="44sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvHealthSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cifrado ChaCha20 activo • Núcleo Rust sincronizado"
                            android:textColor="#C9D1D9"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Grid de Métricas Rápidas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#161B22"
                        app:strokeColor="#30363D"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="12dp"
                        android:layout_marginEnd="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Apps Auditadas"
                                android:textColor="#8B949E"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tvTotalAppsAudited"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="#58A6FF"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#161B22"
                        app:strokeColor="#30363D"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="12dp"
                        android:layout_marginStart="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Apps Invasivas"
                                android:textColor="#8B949E"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/tvHighRiskCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="#F85149"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <Button
                    android:id="@+id/btnQuickCheck"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Ejecutar Diagnóstico Completo"
                    android:backgroundTint="#238636"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- ================= TAB 2: ESCÁNER VIRUSTOTAL ================= -->
            <LinearLayout
                android:id="@+id/tabScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B22"
                    app:strokeColor="#30363D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESCÁNER DE ARCHIVOS SHA-256"
                            android:textColor="#58A6FF"
                            android:textStyle="bold"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calcula firmas criptográficas en Rust directo en la CPU."
                            android:textColor="#8B949E"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp" />

                        <Button
                            android:id="@+id/btnScanStorage"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="Auditar Carpeta Downloads"
                            android:backgroundTint="#1F6FEB" />

                        <TextView
                            android:id="@+id/tvScanLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Listo para analizar."
                            android:textColor="#C9D1D9"
                            android:textSize="12sp"
                            android:padding="12dp"
                            android:background="#0D1117"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= TAB 3: BÓVEDA DE CONTRASEÑAS ================= -->
            <LinearLayout
                android:id="@+id/tabVault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B22"
                    app:strokeColor="#30363D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GENERADOR DE ALTA ENTROPÍA"
                            android:textColor="#3FB950"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnGenerateSecret"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Generar Clave Aleatoria (32 Chars)"
                            android:backgroundTint="#238636"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvEntropyPass"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Toca generar..."
                            android:textColor="#7EE787"
                            android:textIsSelectable="true"
                            android:textSize="14sp"
                            android:padding="12dp"
                            android:background="#0D1117"
                            android:layout_marginTop="8dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#30363D"
                            android:layout_marginVertical="16dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CIFRADO INVIOLABLE (CHACHA20-POLY1305)"
                            android:textColor="#D29922"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etVaultKey"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Contraseña Maestra (Argon2id)"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#6E7681"
                            android:inputType="textPassword"
                            android:layout_marginTop="8dp" />

                        <EditText
                            android:id="@+id/etVaultData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Dato a proteger..."
                            android:textColor="#FFFFFF"
                            android:textColorHint="#6E7681" />

                        <Button
                            android:id="@+id/btnEncryptVault"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cifrar Secreto en Rust"
                            android:backgroundTint="#8957E5"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvVaultOutput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#C9D1D9"
                            android:textSize="11sp"
                            android:padding="8dp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= TAB 4: SANDBOX BREVENT & PERMISOS ================= -->
            <LinearLayout
                android:id="@+id/tabSandbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#161B22"
                    app:strokeColor="#30363D"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONTROL PRIVILEGIADO (ROOT / ADB BREVENT)"
                            android:textColor="#F85149"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Permite congelar apps invasivas y forzar revocación de permisos sin avisar."
                            android:textColor="#8B949E"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                        <Button
                            android:id="@+id/btnAuditPermissions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Escanear Apps Peligrosas"
                            android:backgroundTint="#DA3633"
                            android:layout_marginTop="12dp" />

                        <Button
                            android:id="@+id/btnBreventFreeze"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Congelar Apps en Segundo Plano (Brevent)"
                            android:backgroundTint="#21262D"
                            android:textColor="#58A6FF"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvSandboxLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Esperando escaneo de permisos..."
                            android:textColor="#FFA198"
                            android:textSize="12sp"
                            android:padding="12dp"
                            android:background="#0D1117"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#161B22"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
