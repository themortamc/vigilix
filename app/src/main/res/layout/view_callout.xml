<?xml version="1.0" encoding="utf-8"?>
<!-- Bloque de aviso estilo "callout" de Obsidian. Se colorea desde el código (ver Ui.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_callout_info"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/ivCalloutIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="1dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_status_info" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCalloutTitle"
            style="@style/VxCalloutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Título" />

        <TextView
            android:id="@+id/tvCalloutBody"
            style="@style/VxBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Detalle" />
    </LinearLayout>
</LinearLayout>
