<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSecurity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/VxTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sec_title" />

        <TextView
            style="@style/VxMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sec_subtitle" />

        <include
            android:id="@+id/calloutSec"
            layout="@layout/view_callout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Detector de apps con permisos sensibles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/VxHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sec_perms_heading" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshPerms"
                style="@style/VxButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sec_perms_refresh" />

            <ProgressBar
                android:id="@+id/progressPerms"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPermsEmpty"
                style="@style/VxMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/permsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:divider="@drawable/divider_h"
                android:orientation="vertical"
                android:showDividers="middle" />

        </LinearLayout>

        <!-- Bloqueo de apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/VxHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sec_lock_heading" />

            <TextView
                style="@style/VxMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/sec_lock_explain" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLockApp"
                style="@style/VxInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/sec_lock_hint"
                app:endIconMode="none">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLockApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLockApp"
                style="@style/VxButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/sec_lock_button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnlockApp"
                style="@style/VxButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sec_unlock_button" />

            <TextView
                android:id="@+id/tvLockStatus"
                style="@style/VxMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- Historial de escaneos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/VxHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sec_history_heading" />

            <LinearLayout
                android:id="@+id/historyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:divider="@drawable/divider_h"
                android:orientation="vertical"
                android:showDividers="middle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearHistory"
                style="@style/VxTextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sec_history_clear"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>