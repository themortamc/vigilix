<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvFileName"
        style="@style/VxRowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="documento.pdf" />

    <TextView
        android:id="@+id/tvFileMeta"
        style="@style/VxMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="1,2 MB · SHA-256" />

    <TextView
        android:id="@+id/tvFileHash"
        style="@style/VxMono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_code"
        android:padding="10dp"
        android:textSize="13sp"
        tools:text="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFileCopy"
            style="@style/VxTextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/files_copy_hash"
            app:icon="@drawable/ic_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFileVt"
            style="@style/VxTextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/files_virustotal"
            app:icon="@drawable/ic_open" />
    </LinearLayout>
</LinearLayout>
